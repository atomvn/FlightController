 297:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		volatile uint8_t * const pucFirstUserPriorityRegister = ( volatile uint8_t * const ) ( portNVIC_I
 298:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		volatile uint8_t ucMaxPriorityValue;
 299:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 300:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		/* Determine the maximum priority from which ISR safe FreeRTOS API
 301:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		functions can be called.  ISR safe functions are those that end in
 302:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		"FromISR".  FreeRTOS maintains separate thread and ISR API functions to
 303:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		ensure interrupt entry is as fast and simple as possible.
 304:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 305:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		Save the interrupt priority value that is about to be clobbered. */
 306:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		ulOriginalPriority = *pucFirstUserPriorityRegister;
 307:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 308:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		/* Determine the number of priority bits available.  First write to all
 309:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		possible bits. */
 310:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		*pucFirstUserPriorityRegister = portMAX_8_BIT_VALUE;
 311:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 312:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		/* Read the value back to see how many bits stuck. */
 313:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		ucMaxPriorityValue = *pucFirstUserPriorityRegister;
 314:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 315:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		/* Use the same mask on the maximum system call priority. */
 316:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		ucMaxSysCallPriority = configMAX_SYSCALL_INTERRUPT_PRIORITY & ucMaxPriorityValue;
 317:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 318:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		/* Calculate the maximum acceptable priority group value for the number
 319:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		of bits read back. */
 320:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		ulMaxPRIGROUPValue = portMAX_PRIGROUP_BITS;
 321:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		while( ( ucMaxPriorityValue & portTOP_BIT_OF_BYTE ) == portTOP_BIT_OF_BYTE )
 322:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		{
 323:lib/freertos/portable/GCC/ARM_CM3/port.c **** 			ulMaxPRIGROUPValue--;
 324:lib/freertos/portable/GCC/ARM_CM3/port.c **** 			ucMaxPriorityValue <<= ( uint8_t ) 0x01;
 325:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		}
 326:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 327:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		/* Shift the priority group value back to its position within the AIRCR
 328:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		register. */
 329:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		ulMaxPRIGROUPValue <<= portPRIGROUP_SHIFT;
 330:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		ulMaxPRIGROUPValue &= portPRIORITY_GROUP_MASK;
 331:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 332:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		/* Restore the clobbered interrupt priority register to its original
 333:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		value. */
 334:lib/freertos/portable/GCC/ARM_CM3/port.c **** 		*pucFirstUserPriorityRegister = ulOriginalPriority;
 335:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	}
