 216:lib/freertos/portable/GCC/ARM_CM3/port.c **** StackType_t *pxPortInitialiseStack( StackType_t *pxTopOfStack, TaskFunction_t pxCode, void *pvParam
 217:lib/freertos/portable/GCC/ARM_CM3/port.c **** {
 218:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	/* Simulate the stack frame as it would be created by a context switch
 219:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	interrupt. */
 220:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	pxTopOfStack--; /* Offset added to account for the way the MCU uses the stack on entry/exit of int
 221:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	*pxTopOfStack = portINITIAL_XPSR;	/* xPSR */
 222:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	pxTopOfStack--;
 223:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	*pxTopOfStack = ( ( StackType_t ) pxCode ) & portSTART_ADDRESS_MASK;	/* PC */
 224:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	pxTopOfStack--;
 225:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	*pxTopOfStack = ( StackType_t ) portTASK_RETURN_ADDRESS;	/* LR */
 226:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	pxTopOfStack -= 5;	/* R12, R3, R2 and R1. */
 227:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	*pxTopOfStack = ( StackType_t ) pvParameters;	/* R0 */
 228:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	pxTopOfStack -= 8;	/* R11, R10, R9, R8, R7, R6, R5 and R4. */
 229:lib/freertos/portable/GCC/ARM_CM3/port.c **** 
 230:lib/freertos/portable/GCC/ARM_CM3/port.c **** 	return pxTopOfStack;
 231:lib/freertos/portable/GCC/ARM_CM3/port.c **** }
