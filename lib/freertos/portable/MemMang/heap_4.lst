 139:lib/freertos/portable/MemMang/heap_4.c **** /* Create a couple of list links to mark the start and end of the list. */
 140:lib/freertos/portable/MemMang/heap_4.c **** static BlockLink_t xStart, *pxEnd = NULL;
 141:lib/freertos/portable/MemMang/heap_4.c **** 
 142:lib/freertos/portable/MemMang/heap_4.c **** /* Keeps track of the number of free bytes remaining, but says nothing about
 143:lib/freertos/portable/MemMang/heap_4.c **** fragmentation. */
 144:lib/freertos/portable/MemMang/heap_4.c **** static size_t xFreeBytesRemaining = 0U;
