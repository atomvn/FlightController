  70:lib/freertos/portable/MemMang/heap_4.c **** /*
  71:lib/freertos/portable/MemMang/heap_4.c ****  * A sample implementation of pvPortMalloc() and vPortFree() that combines
  72:lib/freertos/portable/MemMang/heap_4.c ****  * (coalescences) adjacent memory blocks as they are freed, and in so doing
  73:lib/freertos/portable/MemMang/heap_4.c ****  * limits memory fragmentation.
  74:lib/freertos/portable/MemMang/heap_4.c ****  *
  75:lib/freertos/portable/MemMang/heap_4.c ****  * See heap_1.c, heap_2.c and heap_3.c for alternative implementations, and the
  76:lib/freertos/portable/MemMang/heap_4.c ****  * memory management pages of http://www.FreeRTOS.org for more information.
  77:lib/freertos/portable/MemMang/heap_4.c ****  */
  78:lib/freertos/portable/MemMang/heap_4.c **** #include <stdlib.h>
  79:lib/freertos/portable/MemMang/heap_4.c **** 
  80:lib/freertos/portable/MemMang/heap_4.c **** /* Defining MPU_WRAPPERS_INCLUDED_FROM_API_FILE prevents task.h from redefining
  81:lib/freertos/portable/MemMang/heap_4.c **** all the API functions to use the MPU wrappers.  That should only be done when
  82:lib/freertos/portable/MemMang/heap_4.c **** task.h is included from an application file. */
  83:lib/freertos/portable/MemMang/heap_4.c **** #define MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  84:lib/freertos/portable/MemMang/heap_4.c **** 
  85:lib/freertos/portable/MemMang/heap_4.c **** #include "FreeRTOS.h"
  86:lib/freertos/portable/MemMang/heap_4.c **** #include "task.h"
  87:lib/freertos/portable/MemMang/heap_4.c **** 
  88:lib/freertos/portable/MemMang/heap_4.c **** #undef MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  89:lib/freertos/portable/MemMang/heap_4.c **** 
  90:lib/freertos/portable/MemMang/heap_4.c **** #if( configSUPPORT_DYNAMIC_ALLOCATION == 0 )
  91:lib/freertos/portable/MemMang/heap_4.c **** 	#error This file must not be used if configSUPPORT_DYNAMIC_ALLOCATION is 0
  92:lib/freertos/portable/MemMang/heap_4.c **** #endif
